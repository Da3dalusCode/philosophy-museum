{
  "name": "philosophy-atlas",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "compile:route-manifest": "node scripts/compileRouteManifest.mjs",
    "check:route-manifest": "node scripts/compileRouteManifest.mjs --check",
    "compile:museum-building": "node scripts/compileContinuousEnfiladeManifest.mjs",
    "check:museum-building": "node scripts/compileContinuousEnfiladeManifest.mjs --check",
    "validate:museum-masterplan": "node scripts/validateMuseumMasterplan.mjs",
    "validate:museum-building-plan": "node scripts/validateSingleLevelBuildingPlan.mjs",
    "audit:routing": "node scripts/auditRouting.mjs",
    "audit:learning-experiences": "node scripts/auditLearningExperiences.mjs",
    "audit:museum": "node scripts/auditMuseum.mjs && node scripts/auditMuseumPlaques.mjs && npm run audit:exhibits",
    "audit:museum-mobile-controls": "node scripts/auditMuseumMobileControls.mjs",
    "audit:museum-plaques": "node scripts/auditMuseumPlaques.mjs",
    "audit:museum-assets": "node scripts/auditMuseumAssets.mjs",
    "audit:gallery01-supplementals": "node scripts/auditGallery01Supplementals.mjs",
    "audit:gallery02-supplementals": "node scripts/auditGallery02Supplementals.mjs",
    "audit:supplementals": "node scripts/auditSupplementalExhibits.mjs",
    "audit:exhibits": "node scripts/auditExhibitReview.mjs && npm run audit:supplementals",
    "audit:articles": "node scripts/auditArticleDepth.mjs",
    "audit:articles:pilots": "node scripts/auditArticleDepth.mjs --id socrates --id nagarjuna --id feminist-philosophy",
    "audit:articles:reviewed": "node scripts/auditReviewedArticleDepth.mjs",
    "audit:accuracy": "node scripts/auditAccuracyMetadata.mjs",
    "audit:editorial": "node scripts/auditEditorial.mjs",
    "audit:integrity": "node scripts/auditReferentialIntegrity.mjs",
    "test:editorial": "node scripts/testEditorialReview.mjs",
    "report:coverage": "node scripts/reportContentCoverage.mjs",
    "report:depth": "node scripts/reportArticleDepth.mjs",
    "report:flagships": "node scripts/reportFlagshipProgram.mjs",
    "report:editorial": "node scripts/reportEditorial.mjs",
    "report:exhibits": "node scripts/auditExhibitReview.mjs --write",
    "report:supplementals": "node scripts/auditSupplementalExhibits.mjs --write",
    "report:gallery01-supplementals": "node scripts/auditGallery01Supplementals.mjs --write",
    "report:gallery02-supplementals": "node scripts/auditGallery02Supplementals.mjs --write",
    "report:bundle": "node scripts/reportBundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.18.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.184.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/three": "^0.184.1"
  }
}
